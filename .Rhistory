},{
list_data$z <- z
list_jSDMparams <- update_jSDMcoef(
list_data,
list_jSDMparams,
list_priors,
list_Xs,
list_SoRSummaries,
model = jsdmModel,
computeVarPart = (iter > nburn & (iter - nburn) %% nthin == 0)
)
psi <- list_jSDMparams$psi
eta <- list_jSDMparams$eta
