library(occPlus)
library(Rcpp); library(RcppArmadillo)
library(here); library(fields); library(tidyverse)
sourceCpp(here("src","functions.cpp"))
source(here("R","mcmcfun.R"))
source(here("R","runOccplus.R"))
source(here("R","output.R"))
source(here("R","simulateData.R"))
# simulate data ------
# settings
{
n_rivers <- 3
n_sites_per_rivers <- 15 # (needs to be a multiple of 3)
n <- n_rivers * n_sites_per_rivers
S <- 2
M <- 3
L <- 1
K <- 2
ncov_psi <- 2
ncov_theta <- 3
ncov_ord <- 2
d <- 2
a_sigma <- b_sigma <- 2
# CREATE RIVER STRUCTURE
{
num_sites_per_branch <- n_sites_per_rivers / 3
points_all <- matrix(NA, n, 2)
L_ij <- matrix(0, n, n)
for(i in seq_len(n_rivers)){
points1_0 <- cbind(1:num_sites_per_branch, 0)
points2_0 <- cbind(-(1:num_sites_per_branch), 0)
points3_0 <- cbind(0, rev(-(1:num_sites_per_branch)))
# two converging streams into one
points1 <- (n_sites_per_rivers)*(i-1) + points1_0
points2 <- (n_sites_per_rivers)*(i-1) + points2_0
points3 <- (n_sites_per_rivers)*(i-1) + points3_0
points <- rbind(points1, points2, points3)
points_all[(i - 1) * n_sites_per_rivers + 1:n_sites_per_rivers,] <-
points
L_ij_river <- matrix(0, n_sites_per_rivers, n_sites_per_rivers)
L_ij_river[1:num_sites_per_branch,1:num_sites_per_branch] <- createDistance(points1_0)
L_ij_river[num_sites_per_branch + 1:num_sites_per_branch,
num_sites_per_branch + 1:num_sites_per_branch] <- createDistance(points2_0)
L_ij_river[2*num_sites_per_branch + 1:num_sites_per_branch,
2*num_sites_per_branch + 1:num_sites_per_branch] <- createDistance(points3_0)
# for this points, we need to compute the distance manually by rotating the branch
points1_rotated <- cbind(0, 1:num_sites_per_branch)
L_ij_river[1:num_sites_per_branch,
2* num_sites_per_branch + 1:num_sites_per_branch] <- rdist(points1_rotated, points3)
L_ij_river[2* num_sites_per_branch + 1:num_sites_per_branch,
1:num_sites_per_branch] <- rdist(points3, points1_rotated)
L_ij_river[num_sites_per_branch + 1:num_sites_per_branch,
2*num_sites_per_branch + 1:num_sites_per_branch] <- rdist(points1_rotated, points3)
L_ij_river[2*num_sites_per_branch + 1:num_sites_per_branch,
num_sites_per_branch + 1:num_sites_per_branch] <- rdist(points3, points1_rotated)
L_ij[n_sites_per_rivers * (i - 1) + 1:n_sites_per_rivers,
n_sites_per_rivers * (i - 1) + 1:n_sites_per_rivers] <- L_ij_river
}
# qplot(points_all[,1], points_all[,2])
idx_ancestors <- list()
for (j in seq_len(n_rivers)) {
idx_offset <- (j - 1) * n_sites_per_rivers
for (i in 1:(n_sites_per_rivers/3)) {
idx_ancestors[[idx_offset + i]] <-
idx_offset + i:(n_sites_per_rivers/3)
idx_ancestors[[idx_offset + (n_sites_per_rivers/3)+i]] <-
idx_offset + (n_sites_per_rivers/3) + i:(n_sites_per_rivers/3)
idx_ancestors[[idx_offset + 2*(n_sites_per_rivers/3)+i]] <-
idx_offset + c(1:(n_sites_per_rivers*2/3), n_sites_per_rivers*2/3  + i:(n_sites_per_rivers/3))
}
}
idx_region <- rep(1:n_rivers, each = n_sites_per_rivers)
}
edith_params <- list(
A_si = rep(1, n),
Q_j = rep(1, n),
L_ij = L_ij,
nu_ij = matrix(1, n, n),
idx_ancestors = idx_ancestors,
idx_region = idx_region
)
}
