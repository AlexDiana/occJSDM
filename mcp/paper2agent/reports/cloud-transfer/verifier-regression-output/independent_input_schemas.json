{
  "validate_data": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "data_path": {
        "description": "Project-local RDS containing native list(info, OTU, traits); no automatic repairs",
        "type": "string"
      },
      "occCovariates": {
        "description": "Occupancy covariate column names in info, or an explicit empty list",
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "collCovariates": {
        "description": "Collection covariate column names in info, or an explicit empty list",
        "items": {
          "type": "string"
        },
        "type": "array"
      }
    },
    "required": [
      "data_path",
      "occCovariates",
      "collCovariates"
    ]
  },
  "fit_model": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "data_path": {
        "description": "Project-local RDS containing native occJSDM-ready data",
        "type": "string"
      },
      "options": {
        "additionalProperties": false,
        "properties": {
          "occCovariates": {
            "description": "Selected occupancy columns in info, or an explicit empty list",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "collCovariates": {
            "description": "Selected collection columns in info, or an explicit empty list",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "threshold": {
            "description": "Integer read threshold for replicated observations",
            "minimum": 1,
            "type": "integer"
          },
          "listParams": {
            "additionalProperties": false,
            "properties": {
              "n_factors": {
                "description": "Number of native latent factors",
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "n_factors"
            ],
            "type": "object",
            "description": "Native latent-factor settings"
          },
          "MCMCparams": {
            "additionalProperties": false,
            "properties": {
              "nchain": {
                "description": "Number of chains, at least two for diagnostics",
                "minimum": 2,
                "type": "integer"
              },
              "nburn": {
                "description": "Discarded burn-in iterations per chain",
                "minimum": 0,
                "type": "integer"
              },
              "niter": {
                "description": "Retained draws per chain; native very-short-fit errors are preserved",
                "minimum": 1,
                "type": "integer"
              },
              "nthin": {
                "description": "Iterations between retained draws",
                "minimum": 1,
                "type": "integer"
              }
            },
            "required": [
              "nchain",
              "nburn",
              "niter",
              "nthin"
            ],
            "type": "object",
            "description": "Explicit native chain settings"
          }
        },
        "required": [
          "occCovariates",
          "collCovariates",
          "threshold",
          "listParams",
          "MCMCparams"
        ],
        "type": "object",
        "description": "Explicit covariates, threshold, latent factors and MCMC settings; unknown and spatial options rejected"
      },
      "seed": {
        "description": "Seed passed to native R set.seed before fitting",
        "maximum": 2147483647,
        "minimum": 0,
        "type": "integer"
      }
    },
    "required": [
      "data_path",
      "options",
      "seed"
    ]
  },
  "diagnostics": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "fit_id": {
        "description": "Server-owned identifier returned by fit_model",
        "type": "string"
      },
      "max_rows": {
        "default": 20,
        "description": "Maximum diagnostic preview rows, capped at 20",
        "maximum": 20,
        "minimum": 1,
        "type": "integer"
      }
    },
    "required": [
      "fit_id"
    ]
  },
  "summarise_fit": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "fit_id": {
        "description": "Server-owned identifier returned by fit_model",
        "type": "string"
      },
      "max_rows": {
        "default": 20,
        "description": "Maximum baseline occupancy preview rows, capped at 20",
        "maximum": 20,
        "minimum": 1,
        "type": "integer"
      }
    },
    "required": [
      "fit_id"
    ]
  }
}
